{
  "name": "flow-root",
  "version": "1.0.0",
  "private": true,
  "description": "FLOW - Layout Engineering Platform (MERN Stack)",
  "scripts": {
    "postinstall": "npm install --prefix server && npm install --prefix client",
    "start": "concurrently \"npm start --prefix server\" \"npm start --prefix client\"",
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "preview": "npm run preview --prefix client"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
